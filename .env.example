# Copia este archivo como ".env" y rellena tus valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Base de datos SQLite local (puedes dejarlo así)
DATABASE_URL=file:data/tareas.db

# --- Fase 2: Moodle -------------------------------------------------------
# URL de tu Moodle, sin barra al final. Ej: https://aulavirtual.miuni.es
MOODLE_URL=
# Token del servicio moodle_mobile_app (ver README)
MOODLE_TOKEN=

# --- Fase 3: Google Calendar ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
